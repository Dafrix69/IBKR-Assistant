{
  "_comment": "复制为 config/settings.json 后修改。此文件不含任何密钥:LLM API Key 与 IBKR 凭证只存 macOS Keychain(§9.2)。",
  "prompt_version": "v1.0.0",

  "llm": {
    "provider": "anthropic",
    "model": "claude-opus-5",
    "effort": "high",
    "temperature": null,
    "base_url": "",
    "max_tokens": 8000,
    "timeout_s": 60.0,
    "keychain_service": "dafri-llm-api-key",
    "keychain_account": "anthropic"
  },

  "limits": {
    "max_order_notional": 5000.0,
    "max_option_contracts": 5,
    "max_mkt_shares": 200,
    "min_confidence": 0.9,
    "max_spread_slippage": 0.10,
    "max_orders_per_input": 5,
    "duplicate_window_minutes": 10,
    "duplicate_qty_tolerance": 0.2
  },

  "policies": {
    "auto_execute": false,
    "allow_live_trading": false,
    "require_trigger_price_verification": true,
    "trigger_min_gap_bps": 5.0,
    "closed_market_policy": "reject_market_orders",
    "consecutive_failure_breaker": 3,
    "review_feature_enabled": false
  },

  "connections": {
    "paper": {"host": "127.0.0.1", "port": 7497, "client_id": 11},
    "live":  {"host": "127.0.0.1", "port": 7496, "client_id": 12}
  },

  "accounts": [
    {"alias": "模拟", "account_id": "DU0000000", "is_paper": true,  "connection": "paper", "default": true},
    {"alias": "主账户", "account_id": "U0000000", "is_paper": false, "connection": "live"}
  ],

  "symbol_aliases": {
    "苹果": "AAPL", "特斯拉": "TSLA", "英伟达": "NVDA", "微软": "MSFT", "谷歌": "GOOGL",
    "亚马逊": "AMZN", "台积电": "TSM", "阿里巴巴": "BABA", "拼多多": "PDD", "京东": "JD",
    "标普500ETF": "SPY", "纳指ETF": "QQQ"
  },

  "index_symbols": {
    "SPX": {"exchange": "CBOE", "daily_trading_class": "SPXW", "monthly_trading_class": "SPX"},
    "NDX": {"exchange": "NASDAQ", "daily_trading_class": "NDXP", "monthly_trading_class": "NDX"},
    "VIX": {"exchange": "CBOE", "daily_trading_class": "VIX", "monthly_trading_class": "VIX"},
    "RUT": {"exchange": "CBOE", "daily_trading_class": "RUTW", "monthly_trading_class": "RUT"}
  },

  "market_holidays": [
    "2026-01-01", "2026-01-19", "2026-02-16", "2026-04-03", "2026-05-25",
    "2026-06-19", "2026-07-03", "2026-09-07", "2026-11-26", "2026-12-25"
  ],
  "early_close_days": ["2026-11-27", "2026-12-24"],

  "storage": {
    "db_path": "~/Library/Application Support/dafri/trades.db"
  }
}
