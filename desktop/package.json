{
  "name": "dafri-desktop",
  "productName": "IBKR-Assistant",
  "version": "0.5.1",
  "license": "MIT",
  "author": "Dafrix69",
  "private": true,
  "description": "IBKR 交易指令解析引擎的桌面界面(Electron 外壳 + TS 交易引擎子进程)",
  "main": "main.js",
  "scripts": {
    "prestart": "node tools/ensure_engine_ts.js && npm run ui:build",
    "start": "electron .",
    "predev": "node tools/ensure_engine_ts.js && npm run ui:build",
    "dev": "DAFRI_DEV=1 electron .",
    "ui:build": "vite build --config renderer-react/vite.config.mts",
    "ui:watch": "vite build --watch --config renderer-react/vite.config.mts",
    "ui:preview": "vite build --mode preview --config renderer-react/vite.config.mts",
    "ui:typecheck": "tsc -p renderer-react/tsconfig.json",
    "lint": "eslint .",
    "depcruise": "depcruise renderer-react/src --config .dependency-cruiser.cjs",
    "dist:mac": "node tools/dist_mac.js",
    "dist:mac:signed": "node tools/dist_mac.js --signed",
    "dist:win": "npm run ui:build && npm run notices && npm run stage:engine:win && npm run smoke:engine && electron-builder --win nsis --x64 --publish never",
    "dist": "npm run dist:mac && npm run dist:win",
    "stage:engine:win": "node tools/ensure_engine_ts.js && node tools/stage_engine_ts.js --platform win32 --arch x64",
    "stage:engine:mac": "node tools/ensure_engine_ts.js && node tools/stage_engine_ts.js --platform darwin --arch arm64",
    "smoke:engine": "node tools/smoke_engine_ts.js",
    "notices": "node tools/gen_notices.js",
    "notices:check": "node tools/gen_notices.js --check",
    "release:check": "node tools/check_release.js"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.5.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.dafri.trading",
    "productName": "IBKR-Assistant",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "rpc-client.js",
      "popup-window.js",
      "popup-preload.js",
      "update-check.js",
      "config-guard.js",
      "store-guard.js",
      "consent.js",
      "confirm-grants.js",
      "redact.js",
      "diagnostics.js",
      "support-ipc.js",
      "power-watch.js",
      "lid-guard.js",
      "accounts-setup.js",
      "popup/**/*",
      "renderer-react/dist/**/*",
      "!**/* [0-9].*",
      "!**/* [0-9]"
    ],
    "extraResources": [
      {
        "from": "../prompts",
        "to": "engine/prompts"
      },
      {
        "from": "../config/settings.example.json",
        "to": "engine/settings.example.json"
      },
      {
        "from": "build/engine-ts",
        "to": "engine-ts",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "build/engine-ts/node_modules",
        "to": "engine-ts/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../docs/legal",
        "to": "legal",
        "filter": [
          "*.md",
          "!README.md"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "IBKR-Assistant-${version}-mac-${arch}.${ext}",
      "electronLanguages": [
        "zh_CN",
        "zh_TW",
        "en"
      ]
    },
    "dmg": {
      "title": "IBKR-Assistant",
      "format": "ULFO",
      "writeUpdateInfo": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "IBKR-Assistant-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "IBKR-Assistant"
    },
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  }
}
