<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Chromium 需要 JIT(§9.7 Hardened Runtime) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- 出站连接:LLA API 域名 + 本机 TWS 端口(§10.3 唯一出网点) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- 交易引擎是子进程,需要继承运行时权限 -->
    <key>com.apple.security.inherit</key>
    <true/>

    <!--
      注意:这里没有开 com.apple.security.app-sandbox。
      App Sandbox 对子进程与网络的限制尚未在引擎子进程(Electron 自带 Node 拉起 resources/engine-ts)上验证。
      要满足 §9.7 的 "App Sandbox + Hardened Runtime",得先验证沙箱下能拉起引擎并连 127.0.0.1 的 TWS,
      再打开 app-sandbox,并把 Keychain 访问组一并声明。
      在没做这一步之前就打开 app-sandbox,应用会在启动引擎时静默失败。
    -->
</dict>
</plist>
