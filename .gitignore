# 本地配置含账号别名与真实账号映射,永远不进仓库(§9.2)
config/settings.json
config/*.local.json
# 配置的备份、坏掉时留下的那一份、原子写的临时文件:和 settings.json 一样含真实账号
config/settings.json.bak
config/settings.json.broken-*
config/settings.json.tmp-*

# 桌面端:依赖、打包产物、预览与压测输出
desktop/node_modules/
desktop/dist/
desktop/renderer-react/dist/
desktop/renderer-react/dist-preview/
desktop/build/engine-ts/
# 「本地收件」读窗口的程序,启动前 / 打包时编译(tools/build_inbox_reader.js)
desktop/build/inbox-reader/
# 打包时生成的第三方许可声明(tools/gen_notices.js)
desktop/build/THIRD-PARTY-NOTICES.txt
.uipreview/

# 引擎自己的忽略见 engine-ts/.gitignore
node_modules/
.claude/
.DS_Store

# 某次把 ~ 当成家目录建出来的数据目录,里面是真实交易记录(S1),不进仓库
~/
